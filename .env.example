# ==============================================================================
# CURSED ENGINE - MULTI-CLIENT EXE MANAGEMENT PANEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database: Neon Serverless Postgres Connection String
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Redis: Upstash Redis REST Credentials (for sliding-window rate limiting & replay nonce TTL)
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Storage: Vercel Blob Read-Write Token (for Base EXE binary storage)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Authentication & Session Secrets
# Generate random 32-byte secret with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="f6c8d28a3013b5d29931efb70295da9f6e07662cbfdb85a2104470081d58296a"
DOWNLOAD_TOKEN_SECRET="a98b47201c905e9d9e4a50d4a9f91a67290bc57140e90c8121db5976b32df511"

# Primary Admin Credentials
ADMIN_EMAIL="admin@cursedengine.internal"
# Bcrypt hash of admin password (e.g., bcrypt of 'ChangeMeNow123!')
# Generate with: node -e "console.log(require('bcryptjs').hashSync('YourPassword', 12))"
ADMIN_PASSWORD_HASH="$2a$12$e8q4WfJ5E4Yc2pL1kG0Oxe4Q3vU0R5gI6fS7bT8mV9xW0yZ1aB2c."

# Ed25519 Cryptographic Keypair (Hex Encoded 64-char private key, 64-char public key)
# Generate with: npm run generate-keys
ED25519_PRIVATE_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ED25519_PUBLIC_KEY="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# Cloudflare Turnstile Bot Protection (Leave blank to bypass in local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Vercel Cron Secret (protects /api/admin/crons/expire-clients)
CRON_SECRET="optional_cron_bearer_token"

# Error Tracking (Optional)
SENTRY_DSN=""
